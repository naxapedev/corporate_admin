# Admin Manager Portal / Vite client environment
#
# Local development with Vite proxy from /api -> http://localhost:4000:
VITE_API_URL=/api

# Production example:
# Replace api.your-domain.com with your deployed backend domain/IP.
# The backend must include this portal origin in ALLOWED_ORIGINS.
#
# VITE_API_URL=https://api.your-domain.com
